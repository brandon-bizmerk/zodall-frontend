# Variables del dashboard. Solo placeholders: los valores reales van en Railway / .env local (ignorado por git).

# SERVIDOR (no NEXT_PUBLIC): URL base fija de la API NestJS a la que el BFF (/api/bff, /api/auth/*) reenvia
# las peticiones con el JWT. Recomendado en Railway: URL de red privada del servicio de la API.
# Si falta, el servidor usa NEXT_PUBLIC_BACKEND_URL.
BACKEND_API_URL=https://api.example.com/api/v1

# SERVIDOR (opcional): origen(es) propios aceptados en Origin para mutaciones, separados por coma.
# Si falta, se deduce de Host / X-Forwarded-Host.
APP_ORIGIN=https://app.example.com

# PUBLICAS (se incrustan en el bundle; nunca poner secretos aqui)
NEXT_PUBLIC_BACKEND_URL=https://api.example.com/api/v1
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
NEXT_PUBLIC_WP_PLUGIN_URL=https://example.com/plugin.zip
